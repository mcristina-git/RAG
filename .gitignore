# Ambienti virtuali Python
.venv/
venv/
env/
ENV/

# Byte-compiled / cache Python
__pycache__/
*.py[cod]
*$py.class

# Database vettoriale locale ChromaDB (generato con `python ingest.py`)
chroma_db/

# Documenti sorgente locali (mantiene la cartella vuota tramite .gitkeep)
Documenti/*
!Documenti/.gitkeep

# File temporanei Office / Word / sistema
~$*
*.tmp
.DS_Store
Thumbs.db

# Variabili d'ambiente locali e appunti personali
.env
.env.*
ReadMe.txt
readme.txt
